# Copy this file to .env for local development. Do not commit real credentials.
ATB_ENVIRONMENT=development
ATB_LOG_LEVEL=INFO
ATB_API_HOST=127.0.0.1
ATB_API_PORT=8000
ATB_DATABASE_URL=postgresql+asyncpg://adaptive_bot:local-dev-only@localhost:5432/adaptive_trading_bot
ATB_LIVE_TRADING_ENABLED=false
